# Copy this file to .env and fill it in.  NEVER commit .env (it is in .gitignore).

# --- Server ---------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Set to true when the API is served over https (marks the login cookie "Secure")
COOKIE_SECURE=false

# --- MySQL ----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=inventory_management
# DB_CONNECTION_LIMIT=10

# --- Authentication -------------------------------------------------------
# Long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# --- CORS -----------------------------------------------------------------
# localhost and private-network (LAN) origins on the Vite port are always allowed.
# Add ONE extra browser origin here (production site or a dev tunnel). No trailing slash.
CLIENT_ORIGIN=
# CLIENT_DEV_PORT=5173

# --- Push notifications (phone / desktop, free) ---------------------------
# Generate once:  npx web-push generate-vapid-keys   (keep the private key secret, never commit it)
# Leave empty to keep push notifications off. Browsers allow push only on https (or http://localhost).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push services can reach if something goes wrong
VAPID_SUBJECT=mailto:admin@example.com
