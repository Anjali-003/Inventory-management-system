{
  "name": "backend",
  "version": "1.0.0",
  "description": "Inventory Management System API (Express + MySQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest run",
    "migrate": "node src/database/migrate.js",
    "migrate:baseline": "node src/database/migrate.js --baseline",
    "db:schema": "node src/database/run-sql.js schema.sql",
    "db:seed": "node src/database/run-sql.js seed.sql",
    "db:setup": "npm run db:schema && npm run migrate && npm run db:seed",
    "db:shell": "mysql -u root -p inventory_management",
    "schema:dump": "node src/database/schema-dump.js",
    "schema:check": "node src/database/schema-check.js",
    "seed": "node src/database/run-seeds.js",
    "seed:reset": "node src/database/run-seeds.js --reset",
    "super-admin": "node src/scripts/create-super-admin.js",
    "create-user": "node src/scripts/create-user.js",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
