# Copy this file to .env.  Only variables starting with VITE_ reach the browser.
# Restart `npm run dev` after changing it.

# Data source:
#   mysql -> real backend + MySQL (default)
#   mock  -> every request is answered in the browser from src/api/mock/*; no backend needed
VITE_DATA_MODE=mysql

# Full API base URL. Leave empty in development: it is derived from the address the app was opened on
# (http://<same-host>:5000/api/v1, or the matching dev-tunnel host).
# Production example: https://api.example.com/api/v1
# VITE_API_URL=
